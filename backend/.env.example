# 环境变量配置示例
# 复制此文件为 .env 并修改相应配置

# Flask环境
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# 加密密钥（生产环境必须修改）
ENCRYPTION_KEY=your-secret-encryption-key-change-in-production

# MySQL配置（开发环境）
MYSQL_USER=root
MYSQL_PASSWORD=12345678
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=task_scheduler_dev

# 达梦数据库配置（生产环境）
# DM_USER=SYSDBA
# DM_PASSWORD=your_password
# DM_HOST=127.0.0.1
# DM_PORT=5236
# DM_DATABASE=TASK_DB

# 邮件配置
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_auth_code

# 导出路径
EXPORT_DEFAULT_PATH=./exports/
